{
  "schemaVersion": 1,
  "id": "fox-pet",
  "name": "Fox Pet",
  "version": "2.1.0",
  "author": "User",
  "license": "MIT",
  "description": "A playful fox that wanders, blinks, naps, and reacts to clicks and drags.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "activation": "on-demand",
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Fox Pet",
    "description": "Toggle the desktop fox companion",
    "category": "Fun",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Show fox",
        "default": false
      },
      {
        "key": "scale",
        "type": "number",
        "label": "Size",
        "default": 1.0,
        "min": 0.5,
        "max": 2.0,
        "step": 0.05
      },
      {
        "key": "physicsEnabled",
        "type": "boolean",
        "label": "Wander around",
        "default": true
      },
      {
        "key": "showShadow",
        "type": "boolean",
        "label": "Drop shadow",
        "default": true
      },
      {
        "key": "followCursor",
        "type": "boolean",
        "label": "Glance at cursor",
        "default": true
      }
    ]
  }
}
